{
  "openapi": "3.1.0",
  "info": {
    "title": "ChatKeeper archive API",
    "version": "0.3.0"
  },
  "security": [
    {
      "bearerAuth": []
    },
    {
      "session": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ck_session",
        "description": "Administrator browser session; desktop cookie name includes listener port."
      }
    },
    "schemas": {
      "Hit": {
        "type": "object",
        "required": [
          "workspace",
          "channel",
          "root_ts",
          "snippet",
          "permalink",
          "score",
          "source_deleted",
          "prior_versions"
        ],
        "properties": {
          "workspace": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "root_ts": {
            "type": "string"
          },
          "snippet": {
            "type": "string"
          },
          "permalink": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "source_deleted": {
            "type": "boolean"
          },
          "prior_versions": {
            "type": "boolean"
          }
        }
      },
      "SearchPage": {
        "type": "object",
        "required": [
          "results",
          "next_cursor"
        ],
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Hit"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Thread": {
        "type": "object",
        "required": [
          "workspace",
          "channel",
          "root_ts",
          "manifest",
          "messages",
          "users"
        ],
        "properties": {
          "workspace": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "root_ts": {
            "type": "string"
          },
          "manifest": {
            "type": "object"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "users": {
            "type": "object"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/api/search": {
      "get": {
        "operationId": "searchThreads",
        "summary": "Ranked thread matches, ascending BM25 with deterministic identity ties.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "SQLite FTS5 unicode61 query over current and retained historical text."
            }
          },
          {
            "name": "workspace",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "channel",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "author",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Exact participant ID, including replies and prior versions."
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Inclusive root time: epoch seconds or ISO 8601 (UTC if no offset)."
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Exclusive root time: epoch seconds or ISO 8601 (UTC if no offset)."
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Opaque continuation for the same query and unchanged indexes."
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Compatibility alias for after; do not supply both."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchPage"
                }
              }
            }
          },
          "400": {
            "description": "Sanitized error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Sanitized error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Sanitized error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/threads/{workspace}/{channel}/{ts}": {
      "get": {
        "operationId": "getThread",
        "summary": "Verified archived JSON including schema-2 annotations; no binary attachments.",
        "parameters": [
          {
            "name": "workspace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "channel",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ts",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Thread"
                }
              }
            }
          },
          "400": {
            "description": "Sanitized error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Sanitized error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Sanitized error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Sanitized error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
}
